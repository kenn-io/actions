{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Hold every third-party release for 7 days before Renovate proposes it. kenn-io releases and security fixes are exempt.",
  "dependencyDashboard": false,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "npm": {
    "lockFileMaintenance": {
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  },
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "prCreation": "immediate",
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "kenn-io releases open right away: no release-age wait and no weekly window.",
      "matchPackageNames": [
        "kenn-io/**",
        "github.com/kenn-io/**",
        "go.kenn.io/**",
        "@kenn-io/**",
        "ghcr.io/kenn-io/**"
      ],
      "minimumReleaseAge": null,
      "schedule": ["at any time"]
    }
  ]
}
